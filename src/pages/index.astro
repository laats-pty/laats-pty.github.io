---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import QuickLinks from '../components/sections/QuickLinks.astro';
import Calculators from '../components/sections/Calculators.astro';
import FAQ from '../components/sections/FAQ.astro';
import content from '../../content/content.json';
import type { AccessSection, QuickLink } from '../lib/types';
---

<BaseLayout title={content.site.name} description={content.site.tagline}>
  <Header logo={content.site.logoUrl} />
  <main id="main-content">
    <Hero site={content.site} />
    <QuickLinks links={content.quickLinks as QuickLink[]} text={content.sections.accesos as AccessSection} />
    <Calculators text={content.sections.calculadoras} />
    <FAQ items={content.faq} text={content.sections.faq} />
  </main>
  <Footer email={content.site.contactEmail} phone={content.site.contactPhone} phoneLabel={content.site.contactPhoneLabel} />
</BaseLayout>
