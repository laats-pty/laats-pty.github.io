---
// Fuentes alojadas en el propio sitio (sin orígenes externos en la CSP).
import '@fontsource-variable/montserrat';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/globals.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-portal.jpg', Astro.site).href;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Portal interno de empleados: no debe aparecer en buscadores.
        No agregar "Disallow: /" en robots.txt — bloquear el rastreo impide
        que Google llegue a leer este noindex y deje de indexar el sitio. */}
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#275B88" />
    {/* form-action 'none': la página no tiene formularios propios; los
        trámites son enlaces a Google/Microsoft Forms, que no pasan por CSP.
        Sin 'unsafe-eval': se usa el build CSP de Alpine (@alpinejs/csp), que
        interpreta las expresiones sin new Function. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'self'; form-action 'none';"
    />
    {/* Vista previa al compartir el enlace (WhatsApp, Teams). La imagen se
        genera con scripts/generar-og.py: logo oficial y todo el contenido
        dentro del cuadrado central, que es lo que WhatsApp muestra. */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PA" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Portal RRHH LAATS Panamá" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* favicon.ico es el ícono oficial de laats.net (PNG de 150×150). */}
    <link rel="icon" href="/favicon.ico" type="image/png" />
    {/* Orden obligatorio: primero los componentes (se registran en
        alpine:init) y después Alpine. Ambos son diferidos y se ejecutan en
        el orden del documento. */}
    <script>
      import '../../scripts/calculators';
    </script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/@alpinejs/csp@3.17.5/dist/cdn.min.js"
      integrity="sha384-Q4UOujiwqAb/jTt3ki4pdkETk4I3rIFQX8h271PLI41okj/YIKY7IQQFMw73wkrX"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir al contenido principal</a>
    <slot />
  </body>
</html>
