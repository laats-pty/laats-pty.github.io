---
interface Props {
  email: string;
}
const { email } = Astro.props;
---

<footer class="on-dark bg-[var(--color-primary-dark)]">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <div class="py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center">
      <p class="text-white/70 text-sm">
        © {new Date().getFullYear()} LAATS Panamá. Todos los derechos reservados.
      </p>
      <p class="text-white/70 text-sm">
        ¿Preguntas?{' '}
        <a href={`mailto:${email}`} class="text-[var(--color-accent)] underline underline-offset-4 hover:text-white transition-colors rounded">{email}</a>
      </p>
    </div>
  </div>
</footer>
