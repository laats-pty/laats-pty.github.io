---
const campos = [
  { id: 'liq-anios', model: 'anios', label: 'Años trabajados' },
  { id: 'liq-meses', model: 'mesesAdicionales', label: 'Meses adicionales (sobre años completos)', max: 11 },
  { id: 'liq-vacaciones', model: 'diasVacaciones', label: 'Días de vacaciones pendientes' },
  { id: 'liq-decimo', model: 'mesesDecimo', label: 'Meses de décimo sin cobrar (año actual)', max: 11 },
];
const lineas = [
  { label: 'Prima de antigüedad:', campo: 'primaAntiguedad' },
  { label: 'Vacaciones proporcionales:', campo: 'vacacionesProporcionales' },
  { label: 'Décimo proporcional:', campo: 'decimoProporcional' },
];
---

<div x-data="liquidationCalc" x-on:input="invalidar()" class="space-y-6">
  <p class="note-legal">
    Ley 44 de 1995 + Código de Trabajo — Prima de antigüedad + Vacaciones + Décimo + Preaviso
  </p>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="sm:col-span-2">
      <label for="liq-salario" class="field-label">Salario mensual (B/.)</label>
      <input id="liq-salario" x-model="salario" type="number" inputmode="decimal" min="0" step="0.01" placeholder="Ej: 800" class="field" />
    </div>
    {campos.map((c) => (
      <div>
        <label for={c.id} class="field-label">{c.label}</label>
        <input id={c.id} x-model={c.model} type="number" inputmode="numeric" min="0" max={"max" in c ? c.max : undefined} placeholder="0" class="field" />
      </div>
    ))}
  </div>

  <div class="space-y-2">
    <button type="button" class="btn-primary" x-on:click="calcular()">Calcular liquidación</button>
    <p class="form-error" role="alert" x-show="error" x-text="error" style="display:none;"></p>
  </div>

  <div aria-live="polite">
    <div x-show="resultado" x-transition class="result-box" style="display:none;">
      <h3 class="result-title">Desglose de liquidación</h3>
      <ul class="space-y-2 text-sm">
        {lineas.map((l) => (
          <li class="flex justify-between gap-3">
            <span class="text-[var(--color-muted)]">{l.label}</span>
            <span class="font-mono font-semibold whitespace-nowrap" x-text={`resultado ? money(resultado.${l.campo}) : ''`}></span>
          </li>
        ))}
        <li class="flex justify-between gap-3">
          <span class="text-[var(--color-muted)]">Preaviso (<span x-text="resultado ? resultado.semanasPreaviso : ''"></span> sem.):</span>
          <span class="font-mono font-semibold whitespace-nowrap" x-text="resultado ? money(resultado.montoPreaviso) : ''"></span>
        </li>
      </ul>
      <div class="result-total">
        <span class="result-title">Total estimado:</span>
        <span class="result-total-amount" x-text="resultado ? money(resultado.total) : ''"></span>
      </div>
      <p class="disclaimer">
        ⚠️ <strong>Esta es una estimación de referencia.</strong> El monto real de la liquidación siempre dependerá de los salarios efectivamente devengados por el empleado durante su relación laboral, incluyendo sobretiempos, recargos y otros ingresos variables. Para el cálculo oficial, consulta con el departamento de RRHH.
      </p>
    </div>
  </div>
</div>
