---
import { OVERTIME_DIVISORS, OVERTIME_GROUPS, formatFactor } from '../../lib/calculations';
---

<div x-data="overtimeCalc" x-on:input="invalidar()" class="space-y-6">
  <p class="note-legal">
    Ley 44 de 1995, Art. 26 — Factores según estructura PayDay. El recargo ×1.75 aplica a partir de la 3.ª hora diaria o la 9.ª hora semanal de sobretiempo.
  </p>

  <div role="group" aria-labelledby="ot-tipo-label">
    <p id="ot-tipo-label" class="field-label !mb-2">Tipo de empleado (rotación)</p>
    <div class="flex gap-2">
      <button type="button" class="toggle" aria-pressed="true" x-bind:aria-pressed="(tipo === 'fijo').toString()" x-on:click="setTipo('fijo')">
        Fijo (6×2) <span class="whitespace-nowrap">÷ {OVERTIME_DIVISORS.fijo} h</span>
      </button>
      <button type="button" class="toggle" aria-pressed="false" x-bind:aria-pressed="(tipo === 'temporal').toString()" x-on:click="setTipo('temporal')">
        Temporal (6×1) <span class="whitespace-nowrap">÷ {OVERTIME_DIVISORS.temporal} h</span>
      </button>
    </div>
  </div>

  <div class="max-w-xs">
    <label for="ot-salario" class="field-label">Salario mensual (B/.)</label>
    <input id="ot-salario" x-model="salario" type="number" inputmode="decimal" min="0" step="0.01" placeholder="Ej: 1000" class="field" aria-describedby="ot-salario-hora" />
    <p id="ot-salario-hora" class="text-xs text-[var(--color-muted)] mt-1">
      Salario/hora: <strong x-text="salarioHoraTexto">—</strong>
      <span x-text="'(÷ ' + divisor + ' h)'">(÷ {OVERTIME_DIVISORS.fijo} h)</span>
    </p>
  </div>

  <p class="text-sm text-[var(--color-muted)] !-mb-3">Abre solo los grupos en los que tengas horas que ingresar.</p>

  <table class="w-full text-sm border-collapse">
    <caption class="sr-only">Horas de sobretiempo por tipo</caption>
    <thead>
      <tr class="bg-[var(--color-bg)] text-left">
        <th scope="col" class="px-2 sm:px-3 py-2 font-semibold border-b border-[var(--color-border)]">Tipo de sobretiempo</th>
        <th scope="col" class="hidden sm:table-cell px-3 py-2 font-semibold border-b border-[var(--color-border)] text-center">Factor</th>
        <th scope="col" class="px-2 sm:px-3 py-2 font-semibold border-b border-[var(--color-border)] text-center w-20 sm:w-24">Horas</th>
        <th scope="col" class="px-2 sm:px-3 py-2 font-semibold border-b border-[var(--color-border)] text-right w-24 sm:w-28">Monto</th>
      </tr>
    </thead>
    {OVERTIME_GROUPS.map((group, i) => (
      <tbody>
        <tr>
          <th scope="colgroup" colspan="4" class="p-0 border-b border-[var(--color-border)]">
            <button type="button" class="group-toggle" aria-expanded="false" x-bind:aria-expanded={`estaAbierto(${i}).toString()`} x-on:click={`alternarGrupo(${i})`}>
              <span class="flex-1">{group.title}</span>
              <span class="group-summary" x-text={`resumenGrupo(${i})`}></span>
              <svg class="group-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
          </th>
        </tr>
        {group.categories.map((c) => (
          <tr x-show={`estaAbierto(${i})`} style="display:none;" class="hover:bg-[var(--color-bg)] border-b border-[var(--color-border)]/60">
            <th scope="row" class="px-2 sm:px-3 py-2 text-left font-normal">
              {c.label}
              <span class="sm:hidden block font-mono text-xs text-[var(--color-muted)]">{formatFactor(c.factor)}</span>
            </th>
            <td class="hidden sm:table-cell px-3 py-2 text-center font-mono text-[var(--color-muted)]">{formatFactor(c.factor)}</td>
            <td class="px-2 sm:px-3 py-2">
              <input x-model={`horas.${c.code}`} type="number" inputmode="decimal" min="0" step="0.5" placeholder="0" class="field field-sm" aria-label={`Horas de ${c.label}`} />
            </td>
            <td class="px-2 sm:px-3 py-2 text-right font-mono" x-text={`montoLinea('${c.code}')`}>—</td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>

  <div class="space-y-2">
    <button type="button" class="btn-primary" x-on:click="calcular()">Calcular total sobretiempos</button>
    <p class="form-error" role="alert" x-show="error" x-text="error" style="display:none;"></p>
  </div>

  <div aria-live="polite">
    <div x-show="resultado" x-transition class="result-box" style="display:none;">
      <h3 class="result-title">Resumen de sobretiempos</h3>
      <p class="text-sm text-[var(--color-muted)]">
        Salario/hora: <span class="font-mono font-semibold text-[var(--color-text)]" x-text="resultado ? money(resultado.salarioHora, 4) : ''"></span>
      </p>
      <ul class="space-y-1 text-sm">
        <template x-for="l in (resultado ? resultado.detalle : [])" x-bind:key="l.code">
          <li class="flex justify-between gap-3">
            <span class="text-[var(--color-muted)]" x-text="l.label + ' (' + l.horas + ' h × ' + l.factor + ')'"></span>
            <span class="font-mono whitespace-nowrap" x-text="money(l.monto)"></span>
          </li>
        </template>
      </ul>
      <div class="result-total">
        <span class="result-title">Total sobretiempos:</span>
        <span class="result-total-amount" x-text="resultado ? money(resultado.total) : ''"></span>
      </div>
      <p class="disclaimer">
        ⚠️ <strong>Referencia orientativa.</strong> Este cálculo tiene como objetivo brindar una referencia de cómo se obtienen los montos, pero el valor real siempre estará sujeto a la realidad particular de cada empleado, incluyendo su salario efectivo, categorías de horas aplicadas y los períodos reportados en PayDay.
      </p>
    </div>
  </div>
</div>
