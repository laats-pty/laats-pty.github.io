---
interface Props {
  site: { name: string; tagline: string; logoUrl: string };
}
const { site } = Astro.props;
---

<section id="inicio" class="on-dark bg-[var(--color-primary)]">
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-10 md:py-14">
    <div class="flex flex-col md:flex-row md:items-center gap-10 md:gap-16">
      <!-- En móvil el logo ya está en el encabezado, justo encima: aquí se muestra desde md. -->
      <div class="hidden md:flex flex-shrink-0">
        <div class="bg-white rounded-xl px-6 py-4 shadow-[0_4px_24px_rgba(0,0,0,0.18)]">
          <img
            src={site.logoUrl}
            alt="LAATS Safety and Quality Services International Panamá"
            width="891"
            height="437"
            class="h-20 w-auto"
          />
        </div>
      </div>
      <div class="text-center md:text-left">
        <h1 class="text-white text-4xl md:text-5xl font-bold leading-[1.1] mb-4">{site.name}</h1>
        <p class="text-white/80 text-lg md:text-xl mb-6 max-w-[52ch]">{site.tagline}</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
          <a
            href="#accesos"
            class="inline-block bg-[var(--color-accent)] text-[var(--color-text)] font-semibold px-8 py-3 rounded-lg hover:brightness-105 hover:-translate-y-0.5 active:scale-[0.98] active:translate-y-0 transition-all duration-200"
          >
            Ver accesos rápidos
          </a>
          <a
            href="#calculadoras"
            class="inline-block bg-white/10 text-white border border-white/20 font-semibold px-8 py-3 rounded-lg hover:bg-white/20 hover:-translate-y-0.5 active:scale-[0.98] active:translate-y-0 transition-all duration-200"
          >
            Ir a calculadoras
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
