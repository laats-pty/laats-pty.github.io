---
import type { FAQItem, SectionText } from '../../lib/types';

interface Props {
  items: FAQItem[];
  text: SectionText;
}
const { items, text } = Astro.props;
---

<section id="faq" class="py-16 px-4 md:px-8 bg-[var(--color-surface)]" aria-labelledby="faq-titulo">
  <div class="max-w-3xl mx-auto">
    <div class="mb-10">
      <p class="eyebrow">{text.eyebrow}</p>
      <h2 id="faq-titulo" class="text-3xl font-bold text-[var(--color-text)] mb-2">{text.title}</h2>
      <p class="text-[var(--color-muted)] max-w-[52ch]">{text.subtitle}</p>
    </div>

    <!-- <details> nativo: accesible por teclado y lector de pantalla, y se
         puede abrir aunque Alpine no cargue. name="faq" deja una sola abierta. -->
    <div class="space-y-2">
      {items.map((item) => (
        <details class="faq-item" name="faq">
          <summary class="flex items-center justify-between gap-4 px-5 py-4 font-medium text-[var(--color-text)] transition-colors rounded-r-xl">
            <h3 class="font-medium">{item.question}</h3>
            <svg class="faq-chevron w-5 h-5 flex-shrink-0 text-[var(--color-muted)] transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <p class="px-5 pb-5 text-[var(--color-muted)] leading-relaxed max-w-[65ch]">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
