---
import OvertimeCalc from '../calculators/OvertimeCalc.astro';
import VacationCalc from '../calculators/VacationCalc.astro';
import ThirteenthCalc from '../calculators/ThirteenthCalc.astro';
import LiquidationCalc from '../calculators/LiquidationCalc.astro';

const tabs = [
  { id: 'sobretiempo', label: 'Sobretiempos', Panel: OvertimeCalc },
  { id: 'vacaciones', label: 'Vacaciones', Panel: VacationCalc },
  { id: 'decimo', label: 'Décimo tercer mes', Panel: ThirteenthCalc },
  { id: 'liquidacion', label: 'Liquidación', Panel: LiquidationCalc },
];
---

<section id="calculadoras" class="py-16 px-4 md:px-8" aria-labelledby="calculadoras-titulo">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <p class="eyebrow">Herramientas</p>
      <h2 id="calculadoras-titulo" class="text-3xl font-bold text-[var(--color-text)] mb-2">Calculadoras laborales</h2>
      <p class="text-[var(--color-muted)] max-w-[48ch]">Cálculos basados en la legislación laboral vigente de Panamá.</p>
    </div>

    <div
      x-data={`tabs('${tabs[0].id}')`}
      class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl overflow-hidden shadow-sm"
    >
      <!-- En móvil las 4 pestañas van en cuadrícula 2×2 para que ninguna quede oculta. -->
      <div
        role="tablist"
        aria-label="Calculadoras"
        x-ref="tablist"
        x-on:keydown.right.prevent="move($event, 1)"
        x-on:keydown.left.prevent="move($event, -1)"
        x-on:keydown.home.prevent="move($event, 'first')"
        x-on:keydown.end.prevent="move($event, 'last')"
        class="grid grid-cols-2 sm:flex border-b border-[var(--color-border)]"
      >
        {tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.id}`}
            data-tab={t.id}
            aria-controls={`panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            x-on:click={`tab = '${t.id}'`}
            x-bind:aria-selected={`(tab === '${t.id}').toString()`}
            x-bind:tabindex={`tab === '${t.id}' ? 0 : -1`}
            x-bind:class={`tab === '${t.id}' ? 'border-[var(--color-primary)] text-[var(--color-primary)] font-semibold' : 'border-transparent text-[var(--color-muted)] hover:text-[var(--color-text)]'`}
            class:list={[
              'px-4 sm:px-5 py-3.5 text-sm text-center border-b-2 -mb-px transition-colors outline-offset-[-2px]',
              i === 0 ? 'border-[var(--color-primary)] text-[var(--color-primary)] font-semibold' : 'border-transparent text-[var(--color-muted)]',
            ]}
          >
            {t.label}
          </button>
        ))}
      </div>

      <div class="p-5 md:p-8">
        {tabs.map((t, i) => (
          <div
            role="tabpanel"
            id={`panel-${t.id}`}
            aria-labelledby={`tab-${t.id}`}
            x-show={`tab === '${t.id}'`}
            style={i === 0 ? undefined : 'display:none;'}
          >
            <t.Panel />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
