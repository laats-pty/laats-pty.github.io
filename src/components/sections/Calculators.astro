---
import OvertimeCalc from '../calculators/OvertimeCalc.astro';
import VacationCalc from '../calculators/VacationCalc.astro';
import ThirteenthCalc from '../calculators/ThirteenthCalc.astro';
import LiquidationCalc from '../calculators/LiquidationCalc.astro';
import type { CalculatorsSection } from '../../lib/types';

interface Props {
  text: CalculatorsSection;
}
const { text } = Astro.props;

const panels: Record<string, any> = {
  sobretiempo: OvertimeCalc,
  vacaciones: VacationCalc,
  decimo: ThirteenthCalc,
  liquidacion: LiquidationCalc,
};
const calcs = text.items.filter((c) => c.id in panels).map((c) => ({ ...c, Panel: panels[c.id] }));
---

<section id="calculadoras" class="py-16 px-4 md:px-8" aria-labelledby="calculadoras-titulo">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <p class="eyebrow">{text.eyebrow}</p>
      <h2 id="calculadoras-titulo" class="text-3xl font-bold text-[var(--color-text)] mb-2">{text.title}</h2>
      <p class="text-[var(--color-muted)] max-w-[52ch]">{text.subtitle}</p>
    </div>

    <!-- Acordeón: todas cerradas al entrar y una abierta a la vez. Lo escrito en una
         calculadora se conserva aunque se cierre (x-show solo la oculta). -->
    <div
      x-data="accordion"
      class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-2xl overflow-hidden shadow-sm divide-y divide-[var(--color-border)]"
    >
      {calcs.map((c) => (
        <div>
          <h3>
            <button
              type="button"
              id={`calc-btn-${c.id}`}
              class="calc-toggle"
              aria-controls={`panel-${c.id}`}
              aria-expanded="false"
              x-bind:aria-expanded={`expanded('${c.id}')`}
              x-on:click={`toggle('${c.id}')`}
            >
              <span class="flex-1 min-w-0">
                <span class="block font-semibold text-[var(--color-text)]">{c.label}</span>
                <span class="block text-sm text-[var(--color-muted)]">{c.hint}</span>
              </span>
              <svg class="calc-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
          </h3>
          <div
            id={`panel-${c.id}`}
            role="region"
            aria-labelledby={`calc-btn-${c.id}`}
            x-show={`isOpen('${c.id}')`}
            style="display:none;"
            class="p-5 md:p-8 border-t border-[var(--color-border)]"
          >
            <c.Panel />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
